PB_IMAGE=ghcr.io/jorgemarinsx/pocketbase_docker:0.0.1-prod
PB_DOMAIN=api.example.com
# unique per PocketBase instance behind the same Traefik
PB_NAME=pocketbase

TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# optional, exactly 32 chars (openssl rand -hex 16)
PB_ENCRYPTION_KEY=

# optional, creates the first superuser on the first deploy only
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
